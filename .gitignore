# Dart / Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# A library must resolve against whatever its consumer already has, so its
# lockfile is noise that goes stale and conflicts. Applications commit theirs;
# packages do not, and everything here is a package.
pubspec.lock

# Generated code, if a package ever adds any.
*.g.dart
*.freezed.dart

# Editors and OS
.idea/
.vscode/
*.iml
.DS_Store

# Snippets generated from the READMEs by `tool/doc_snippets/check.dart`.
# Hidden, so `dart format` and `dart analyze .` skip them without an exclude.
.doc_snippets/

# Coverage output. Anchored per package rather than a bare `coverage/`, which
# matches a directory of that name at any depth — and would swallow
# `tool/coverage/`, which is source.
packages/*/coverage/
lcov.info

# Working documents: the roadmap, the parity decision log, design notes. These
# are how the work is planned and tracked, not what is shipped — the shipped
# documentation is each package's README and its dartdoc, which is what
# pub.dev renders.
docs/

# Parity harness scratch. `package-lock.json` is deliberately *not* ignored:
# the harness pins a reference implementation rather than depending on one, so
# the exact resolved tree is part of the contract, and CI runs `npm ci`.
# The generated fixtures are committed too.
tool/parity/node_modules/
